# ==========================================
# C++ / CMake Standard .gitignore Template
# ==========================================

# ------------------------------------------
# Build Directories & Artifacts
# ------------------------------------------
# Ignore the entire build directory where binaries are compiled
[Bb]uild/
[Bb]in/
[Oo]bj/
[Oo]ut/

# CMake generated files and directories
CMakeCache.txt
CMakeFiles/
CMakeCheckOutputs/
Makefile
cmake_install.cmake
install_manifest.txt
TargetDirectories.txt

# ------------------------------------------
# Compiled Object Files & Libraries
# ------------------------------------------
# Precompiled Headers
*.gch
*.pch

# Object files
*.o
*.obj
*.d

# Libraries and Archives
*.lib
*.a
*.la
*.lo
*.so
*.so.*
*.dylib
*.dll
*.mod

# Executables
*.exe
*.out
*.app
# Specific target binary name from your project configuration
core512

# ------------------------------------------
# IDEs and Text Editors
# ------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/extensions.json

# CLion / IntelliJ IDEA
.idea/
*.iws

# Eclipse
.metadata/
.classpath
.project
.settings/

# Vim / Emacs swap files
*~
*.swp
*.swo
.\#*
#*#

# ------------------------------------------
# Operating System Artifacts
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.directory

# ------------------------------------------
# Testing & Code Coverage
# ------------------------------------------
*.gcno
*.gcda
*.gcov
